.DS_Store
YANG_MODELS/
.env
__pycache__/
.venv/
CLAUDE.md
.mcp.json
.mypy_cache/
incidents.json
investigations.json
state_snapshots.json
config_backups/

# Containerlab runtime output (auto-generated on clab deploy)
clab-testlab/
*.clab.yml.annotations.json

# Per-run logs from run_experiment_matrix.sh
logs/

# Full Logfire trace archive (generated by export_logfire_archive.py, ~100-250 MB;
# only the manifest is tracked — see docs/logfire-archive.md for where the data lives)
logfire_archive/*
!logfire_archive/manifest.json

# LaTeX build artifacts (IP6-Bericht) — generated on every build, regenerated by latexmk
IP6-Bericht/**/*.aux
IP6-Bericht/**/*.bbl
IP6-Bericht/**/*.bbl-SAVE-ERROR
IP6-Bericht/**/*.bcf
IP6-Bericht/**/*.blg
IP6-Bericht/**/*.fdb_latexmk
IP6-Bericht/**/*.fls
IP6-Bericht/**/*.lof
IP6-Bericht/**/*.log
IP6-Bericht/**/*.lot
IP6-Bericht/**/*.out
IP6-Bericht/**/*.run.xml
IP6-Bericht/**/*.synctex.gz
IP6-Bericht/**/*.synctex(busy)
IP6-Bericht/**/*.toc
IP6-Bericht/**/*.xdv
# index
IP6-Bericht/**/*.idx
IP6-Bericht/**/*.ind
IP6-Bericht/**/*.ilg
# glossary / acronyms
IP6-Bericht/**/*.glo
IP6-Bericht/**/*.gls
IP6-Bericht/**/*.glg
IP6-Bericht/**/*.acn
IP6-Bericht/**/*.acr
IP6-Bericht/**/*.alg
# beamer
IP6-Bericht/**/*.nav
IP6-Bericht/**/*.snm
IP6-Bericht/**/*.vrb
# compiled output (top level only — do NOT ignore graphics/*.pdf assets)
IP6-Bericht/*.pdf
