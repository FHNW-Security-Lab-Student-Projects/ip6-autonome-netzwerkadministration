OPENROUTER_API_KEY=your-key-here

# Logfire Write Token
# Get your token from: https://logfire.pydantic.dev/
LOGFIRE_TOKEN=your-logfire-write-token-here

# Logfire READ token for fetch_logfire_exports.py (regenerates the checked-in
# logfire_root_spans.jsonl / logfire_generation_ids.jsonl exports).
# Create under Logfire project settings -> Read tokens.
LOGFIRE_READ_TOKEN=your-logfire-read-token-here

# Set to false to pause automatic investigation creation from Loki polling
AUTO_INVESTIGATIONS_ENABLED=true

# Port for the investigation_status.py web UI (default: 7933)
# INVESTIGATION_STATUS_PORT=7933

# Port for the syslog agent's internal HTTP API (default: 7934)
# AGENT_API_PORT=7934
